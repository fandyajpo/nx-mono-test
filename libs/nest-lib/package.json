{
  "name": "@nx-mono-test/nest-lib",
  "version": "0.0.1",
  "private": true,
  "main": "../../libs/nest-lib/src/index.js",
  "module": "../../libs/nest-lib/src/index.js",
  "types": "../../libs/nest-lib/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./dto": {
      "development": "./src/dto/index.ts",
      "types": "./dist/dto/index.d.ts",
      "import": "./dist/dto/index.js",
      "default": "./dist/dto/index.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@nestjs/testing": "^10.0.2",
    "@nestjs/common": "^10.0.2",
    "class-validator": "^0.14.1"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/libs/nest-lib",
          "tsConfig": "libs/nest-lib/tsconfig.lib.json",
          "packageJson": "libs/nest-lib/package.json",
          "main": "libs/nest-lib/src/index.ts",
          "assets": [
            "libs/nest-lib/*.md"
          ]
        }
      }
    }
  }
}
